# MongoDB connection (default: local dev instance)
MONGODB_URL=mongodb://localhost:27017/acdyon

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Seconds between scheduled watch-mode runs
RUN_INTERVAL_SECONDS=300

# Optional residential/mobile proxy URL — leave blank for demo (no proxy needed)
# Format: http://user:pass@host:port  or  socks5://host:port
PROXY_URL=

# Source adapter toggles
REMOTEOK_ENABLED=true
JSEARCH_ENABLED=true
ARBEITNOW_ENABLED=false

# RapidAPI (JSearch) Credentials
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=jsearch.p.rapidapi.com
JSEARCH_QUERY=Software developer in USA
